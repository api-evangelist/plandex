{
  "opencollection": "1.0.0",
  "info": {
    "name": "Plandex Server Accounts Users API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete Org User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:8099/orgs/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a user from the org."
        },
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8099/users"
          },
          "docs": "List users in the current org."
        }
      ]
    }
  ],
  "bundled": true
}