  "info": {
    "_postman_id": "94504657-5a51-4d20-a89f-31fae22ce1c9",
    "name": "Plandex Server Accounts Settings API",
    "description": "Management and orchestration REST API exposed by the Plandex server (open-source, Go) used by the Plandex CLI/REPL to drive long-running coding plans across organizations, projects, plans, branches, context, conversation, model packs, and configuration. The same API powered Plandex Cloud (winding down 2025-10-03) and now powers self-hosted / local-mode deployments via Docker. Default local-mode bind is http://localhost:8099.\n\nContact Support:\n Name: Plandex AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
